APP_NAME="LLM Wiki Server"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0
QUEUE_JOB_TIMEOUT=9000

DATA_DIR=./data
RAW_DIR=./data/raw
CACHE_DIR=./data/cache

DEFAULT_PROJECT_SLUG=internal-research
DEFAULT_PROJECT_NAME="Internal Research"
QUERY_MODE=rag
SAC_KG_ENABLED=true
VECTOR_STORE_ENABLED=true
VECTOR_STORE_BACKEND=sqlite-vec

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:14b
OLLAMA_FAST_BASE_URL=http://localhost:11435
OLLAMA_DEEP_BASE_URL=http://localhost:11436
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11435
OLLAMA_FAST_MODEL=qwen3:14b
OLLAMA_DEEP_MODEL=qwen3.6:27b
OLLAMA_FAST_CONTEXT_LENGTH=16384
OLLAMA_DEEP_CONTEXT_LENGTH=32768
OLLAMA_FAST_PARALLELISM=1
OLLAMA_DEEP_PARALLELISM=1
OLLAMA_BATCH_MODEL=qwen3:30b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_VISION_MODEL=
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_KEEP_ALIVE=-1

DOCUMENT_INTELLIGENCE_ENABLED=true
PDF_RENDER_DPI=160
OCR_FALLBACK_ENABLED=false
MINERU_ENABLED=false
MINERU_BIN=.venv/Scripts/mineru.exe
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=
MINERU_OUTPUT_DIR=./data/cache/mineru
MINERU_TIMEOUT=7200
MINERU_EXTRA_ARGS=

EXTERNAL_API_ENABLED=true
EXTERNAL_API_BASE_URL=https://api.deepseek.com
EXTERNAL_API_KEY=
EXTERNAL_API_MODEL=deepseek-v4-flash
EXTERNAL_API_TIMEOUT=90

MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=llm-wiki
MINIO_SECURE=false

# Agent orchestration layer (v3 read-only RAG + synthesis + streaming + traces + TTL)
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=5
AGENT_BUDGET_TOKENS=20000
AGENT_TIMEOUT_SECONDS=90
AGENT_ALLOW_EXTERNAL_NETWORK=false
AGENT_MAX_CONVERSATION_TURNS=20
AGENT_SYNTHESIS_PROVIDER=auto
AGENT_CONVERSATION_TTL_DAYS=30
AGENT_TRACE_RETENTION_DAYS=30
AGENT_STREAM_HEARTBEAT_SECONDS=15

# Read-only quality dashboard artifacts
QUALITY_REPORTS_DIR=./tmp
