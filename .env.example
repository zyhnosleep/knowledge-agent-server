APP_NAME=LLM Wiki Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0
QUEUE_JOB_TIMEOUT=3600

DATA_DIR=./data
RAW_DIR=./data/raw
WIKI_DIR=./data/wiki
CACHE_DIR=./data/cache

DEFAULT_PROJECT_SLUG=internal-research
DEFAULT_PROJECT_NAME=Internal Research

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:14b
OLLAMA_BATCH_MODEL=qwen3:30b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b
OLLAMA_VISION_MODEL=
OLLAMA_REQUEST_TIMEOUT=600

DOCUMENT_INTELLIGENCE_ENABLED=true
PDF_RENDER_DPI=160
OCR_FALLBACK_ENABLED=false

EXTERNAL_API_ENABLED=false
EXTERNAL_API_BASE_URL=https://api.openai.com/v1
EXTERNAL_API_KEY=
EXTERNAL_API_MODEL=gpt-4o-mini
EXTERNAL_API_TIMEOUT=90

MINIO_ENABLED=false
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=llm-wiki
MINIO_SECURE=false
