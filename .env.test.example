APP_NAME="Knowledge Agent"
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=8001

DATABASE_URL=postgresql+psycopg://knowledge_agent_test:CHANGE_ME@127.0.0.1:5432/knowledge_agent_test
REDIS_URL=redis://127.0.0.1:6379/2
QUEUE_JOB_TIMEOUT=9000
DATA_DIR=./runtime/data
RAW_DIR=./runtime/data/raw
CACHE_DIR=./runtime/data/cache

DEFAULT_PROJECT_SLUG=internal-research
DEFAULT_PROJECT_NAME="Internal Research"
QUERY_MODE=rag
SAC_KG_ENABLED=false
VECTOR_STORE_ENABLED=true
VECTOR_STORE_BACKEND=pgvector

OLLAMA_GENERATION_BASE_URL=http://127.0.0.1:11436
OLLAMA_GENERATION_MODEL=qwen3.5:9b
OLLAMA_GENERATION_CONTEXT_LENGTH=32768
OLLAMA_GENERATION_PARALLELISM=1
OLLAMA_BATCH_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11436
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBEDDING_DIMENSIONS=2560
OLLAMA_VISION_MODEL=qwen3.5:9b
OLLAMA_REQUEST_TIMEOUT=600
OLLAMA_KEEP_ALIVE=5m

DOCUMENT_INTELLIGENCE_ENABLED=true
PDF_RENDER_DPI=160
OCR_FALLBACK_ENABLED=false
MINERU_ENABLED=false
MINERU_BIN=.venv/bin/mineru
MINERU_BACKEND=pipeline
MINERU_MODEL_SOURCE=modelscope
MINERU_OUTPUT_DIR=./runtime/data/cache/mineru
MINERU_TIMEOUT=7200
MINERU_EXTRA_ARGS=

EXTERNAL_API_ENABLED=false
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=5
AGENT_BUDGET_TOKENS=20000
AGENT_TIMEOUT_SECONDS=180
AGENT_ALLOW_EXTERNAL_NETWORK=false
AGENT_MAX_CONVERSATION_TURNS=20
AGENT_SYNTHESIS_PROVIDER=local
AGENT_CONVERSATION_TTL_DAYS=30
AGENT_TRACE_RETENTION_DAYS=30
AGENT_STREAM_HEARTBEAT_SECONDS=15

AUTH_ENABLED=true
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_ALLOWED_TENANT=
QUALITY_REPORTS_DIR=./runtime/tmp
