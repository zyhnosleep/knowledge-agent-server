# Single-instance, loopback-only PostgreSQL deployment. No private credentials.
APP_HOST=127.0.0.1
APP_PORT=18002
AUTH_ENABLED=false
DATABASE_URL=postgresql+psycopg:///knowledge_agent
VECTOR_STORE_ENABLED=true
VECTOR_STORE_BACKEND=pgvector
VECTOR_STORE_STRICT=true
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=qwen3-vl-embedding:2b
OLLAMA_EMBEDDING_DIMENSIONS=2048
# Copy identities from the loaded encoder's /api/embedding_identity, then
# build a NEW shadow index. Never add these fields to historical manifests.
EMBEDDING_REVISION=
EMBEDDING_PROCESSOR_HASH=
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:18080
OLLAMA_GENERATION_BASE_URL=http://127.0.0.1:18080
OLLAMA_GENERATION_MODEL=qwen3-vl:4b
OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_GENERATION_CONTEXT_LENGTH=32768
OLLAMA_GENERATION_PARALLELISM=1
OLLAMA_BATCH_MODEL=qwen3-vl:4b
OLLAMA_SYNTHESIS_MODEL=qwen3-vl:4b
CONTEXTUALIZATION_MODEL=qwen3-vl:4b
CONTEXTUALIZATION_BASE_URL=http://127.0.0.1:18080
LOCAL_MODEL_HOST=127.0.0.1
LOCAL_MODEL_PORT=18080
LOCAL_MODEL_EMBED_BACKEND=vl
LOCAL_MODEL_IMAGE_EMBED=/opt/models/Qwen3-VL-Embedding-2B
LOCAL_MODEL_CHAT=/opt/models/Qwen3-VL-4B-Instruct
LOCAL_MODEL_CHAT_ADAPTER=
LOCAL_MODEL_CHAT_ALIAS=qwen3-vl:4b
LOCAL_MODEL_PRELOAD=all
LOCAL_MODEL_IMAGE_ROOTS=/opt/knowledge-agent/runtime/data/parsed,/opt/knowledge-agent/runtime/data/cache
DATA_DIR=/opt/knowledge-agent/runtime/data
RAW_DIR=/opt/knowledge-agent/runtime/data/raw
CACHE_DIR=/opt/knowledge-agent/runtime/data/cache
CANONICAL_ARTIFACTS_DIR=/opt/knowledge-agent/runtime/data/parsed
DEFAULT_PROJECT_SLUG=research
DEFAULT_PROJECT_NAME=Research
# No extra planner for normal queries; enable only after live acceptance.
AGENT_ADAPTIVE_ENABLED=false
AGENT_ADAPTIVE_MAX_DECISIONS=3
AGENT_ADAPTIVE_MAX_SUPPLEMENT_RETRIEVALS=2
