APP_ENV=multimodal-pilot
APP_HOST=127.0.0.1
APP_PORT=18002
DATABASE_URL=postgresql+psycopg://root@/llm_wiki_multimodal
DATA_DIR=./runtime/data
RAW_DIR=./runtime/corpus/papers
CACHE_DIR=./runtime/data/cache
CANONICAL_ARTIFACTS_DIR=./runtime/data/parsed
CANONICAL_PIPELINE_VERSION=canonical-v4-multimodal
SEMANTIC_SPLITTING_ENABLED=true
SEMANTIC_SPLITTING_MODEL=qwen3-embedding:4b
SEMANTIC_TOKENIZER_LOCAL_PATH=./runtime/models/Qwen3-Embedding-4B-tokenizer
DEFAULT_PROJECT_SLUG=multimodal-pilot
DEFAULT_PROJECT_NAME="Multimodal Paper Pilot"
QUERY_MODE=rag
SAC_KG_ENABLED=false
VECTOR_STORE_ENABLED=true
VECTOR_STORE_BACKEND=pgvector
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:18080
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b
OLLAMA_EMBEDDING_DIMENSIONS=2560
EMBEDDING_DIMENSIONS=2560
OLLAMA_REQUEST_TIMEOUT=600
MINERU_ENABLED=false
DOCUMENT_INTELLIGENCE_ENABLED=false
OCR_FALLBACK_ENABLED=false
EXTERNAL_API_ENABLED=false
GENERATION_PROVIDER=ollama
AUTH_ENABLED=false
MINIO_ENABLED=false
MULTIMODAL_BACKEND_URL=http://127.0.0.1:18080
