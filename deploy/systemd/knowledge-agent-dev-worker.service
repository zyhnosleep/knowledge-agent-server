[Unit]
Description=Knowledge Agent development ingestion worker
After=network-online.target knowledge-agent-redis.service knowledge-agent-dev-ollama.service
Wants=network-online.target knowledge-agent-dev-ollama.service
Requires=knowledge-agent-redis.service

[Service]
Type=simple
WorkingDirectory=%h/knowledge-agent-dev
EnvironmentFile=%h/knowledge-agent-dev/runtime/app.env
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PYTHONPATH=%h/knowledge-agent-dev/src
Environment=INGESTION_WORKER_QUEUES=ingest.parse,ingest.repair,ingest.canonicalize,ingest.semantic_split,ingest.contextualize,ingest.embed,ingest.index,ingest.activate,ingest
Environment=INGESTION_WORKER_CONCURRENCY=1
ExecStart=%h/knowledge-agent-dev/.venv/bin/python -m app.workers.runner
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
