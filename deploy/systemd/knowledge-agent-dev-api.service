[Unit]
Description=Knowledge Agent development API
After=network-online.target knowledge-agent-dev-ollama.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/knowledge-agent-dev
EnvironmentFile=%h/knowledge-agent-dev/runtime/app.env
ExecStart=%h/knowledge-agent-dev/.venv/bin/python -m uvicorn app.main:app --app-dir src --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
