[Unit]
Description=Internal knowledge-base pilot API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llm_wiki_internal_pilot
EnvironmentFile=%h/llm_wiki_internal_pilot/runtime/auth.env
ExecStart=%h/llm_wiki_internal_pilot/.venv/bin/python -m uvicorn app.main:app --app-dir src --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
